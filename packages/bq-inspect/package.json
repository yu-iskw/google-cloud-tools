{
  "name": "bq-inspect",
  "version": "0.1.1",
  "description": "Read-only BigQuery job inspection CLI and TypeScript library for AI agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yu-iskw/google-cloud-tools.git",
    "directory": "packages/bq-inspect"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bq-inspect": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@google-cloud/bigquery": "8.3.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "google-auth-library": "10.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.7.0"
  }
}
