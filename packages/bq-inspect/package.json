{
  "name": "bq-inspect",
  "version": "0.2.0",
  "description": "Read-only BigQuery job inspection CLI and TypeScript library for AI agents.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bq-inspect": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@google-cloud/bigquery": "8.3.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "google-auth-library": "10.6.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
